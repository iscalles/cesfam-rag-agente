# Copia este archivo como ".env" y completa tu API key de Mistral.
# Se obtiene gratis en https://console.mistral.ai/

LLM_API_KEY=tu_api_key_de_mistral_aqui
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
EMBEDDING_MODEL=mistral-embed

# --- LangSmith (observabilidad y evaluación, módulo IL1.4) -------------
# Opcional: si se deja LANGSMITH_TRACING=false, el agente funciona igual,
# simplemente sin enviar trazas. API key gratuita en https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=tu_api_key_de_langsmith_aqui
LANGSMITH_PROJECT=cesfam-rag-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
